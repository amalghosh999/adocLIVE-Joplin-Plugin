{
  "name": "joplin-plugin-adoclive",
  "version": "1.0.5",
  "description": "adocLIVE AsciiDoc live-preview editor for Joplin",
  "license": "MIT",
  "author": "Amal Ghosh",
  "contributors": [
    "Amal Ghosh <amalghosh999@gmail.com>",
    "Codex <noreply@openai.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amalghosh999/adocLIVE-Joplin-Plugin.git"
  },
  "homepage": "https://github.com/amalghosh999/adocLIVE-Joplin-Plugin",
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "scripts": {
    "build": "npm run dist",
    "build:bundle": "webpack --mode=production",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('publish',{recursive:true,force:true}); fs.rmSync('com.asciidoc.joplin-plugin.jpl',{force:true});\"",
    "dist": "npm run clean && npm run build:bundle && node scripts/create-publish-artifacts.js",
    "build:jpl": "npm run dist",
    "deploy:joplin": "npm run dist && node scripts/deploy-joplin.js",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:lab": "tsc --project tsconfig.lab.json --noEmit --pretty false && tsc --project tsconfig.tools.json --pretty false",
    "test:unit": "vitest run",
    "audit:prod:pr": "node scripts/audit-production.ts --mode pr",
    "audit:prod:release": "node scripts/audit-production.ts --mode release",
    "audit:prod:nightly": "node scripts/audit-production.ts --mode nightly --output .baseline-candidates/audit-nightly.json",
    "baseline:candidates": "node baseline/generate-candidates.ts",
    "baseline:candidates:docker": "node baseline/docker-candidates.ts",
    "baseline:review": "npm run lab:build && node scripts/lab-server.js",
    "baseline:review:import": "node baseline/import-bundle.ts",
    "baseline:apply": "node baseline/apply-receipt.ts",
    "lab": "npm run lab:build && npm run lab:serve",
    "lab:build": "node -e \"require('fs').rmSync('test-lab-dist',{recursive:true,force:true})\" && webpack --config webpack.lab.config.js --mode=development",
    "lab:build:production": "node -e \"require('fs').rmSync('test-lab-dist',{recursive:true,force:true})\" && webpack --config webpack.lab.config.js --mode=production",
    "lab:serve": "node scripts/lab-server.js",
    "lab:serve:dist": "node scripts/lab-server.js --dist",
    "lab:serve:artifact": "node scripts/lab-server.js --artifact",
    "docs:screenshots": "npm run dist && npm run lab:build && node scripts/capture-docs-screenshots.js",
    "test:docs": "vitest run tests/unit/documentation.test.ts",
    "playwright:install": "playwright install chromium",
    "test:browser": "playwright test --grep-invert '@perf|@leak|@artifact|@scroll|@visual|@a11y|@fixture-matrix'",
    "test:browser:headed": "playwright test --headed --workers=1 --grep-invert '@perf|@leak|@artifact|@fixture-matrix'",
    "test:browser:ui": "playwright test --ui",
    "test:scroll": "playwright test --grep '@scroll' --workers=1",
    "test:scroll:characterize": "ADOC_LAB_PRINT_METRICS=1 playwright test tests/browser/scroll.spec.ts --grep 'characterizes 30' --workers=1",
    "test:visual": "playwright test --grep '@visual' --workers=1",
    "test:visual:update": "npm run baseline:candidates",
    "test:a11y": "playwright test --grep '@a11y'",
    "test:fixtures": "playwright test --grep '@fixture-matrix' --workers=1",
    "test:perf": "playwright test --grep '@perf' --workers=1",
    "test:perf:characterize": "ADOC_LAB_PRINT_METRICS=1 playwright test tests/browser/performance.spec.ts --grep 'input p95' --workers=1",
    "test:leak": "NODE_OPTIONS=--expose-gc playwright test --grep '@leak' --workers=1",
    "test:joplin-sim": "vitest run --config vitest.joplin.config.ts",
    "test:artifact-smoke": "npm run dist && vitest run --config vitest.artifact.config.ts && ADOC_LAB_ARTIFACT=1 playwright test tests/browser/artifact.spec.ts --project=chromium --workers=1",
    "native:prepare": "npm run dist && npm run lab:build && node scripts/prepare-native-verification.js",
    "test:protocol": "vitest run tests/contracts",
    "test:lab:pr": "npm run audit:prod:pr && npm run test:unit && npm run typecheck && npm run typecheck:lab && npm run dist && npm run test:joplin-sim && npm run test:browser && npm run test:scroll && npm run test:visual && npm run test:a11y && vitest run --config vitest.artifact.config.ts && ADOC_LAB_ARTIFACT=1 playwright test tests/browser/artifact.spec.ts --project=chromium --workers=1",
    "test:lab:nightly": "npm run test:lab:pr && npm run audit:prod:nightly && npm run test:fixtures && npm run test:perf && npm run test:leak",
    "prepublishOnly": "node -e \"if(process.env.ADOC_RELEASE_PUBLISH!=='1'){console.error('Direct npm publish is disabled; use npm run release:publish with an approved immutable bundle.');process.exit(1)}\"",
    "release": "npm run release:prepare",
    "release:prepare": "node baseline/release-prepare.ts",
    "release:publish": "node baseline/release-publish.ts",
    "dev": "webpack --mode=development --watch"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.11.0",
    "@types/nspell": "^2.1.6",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "fflate": "0.8.3",
    "happy-dom": "^20.9.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "6.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@mermaid-js/layout-elk": "^0.2.1",
    "asciidoctor": "^3.0.4",
    "asciimath2tex": "^1.5.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.39",
    "mermaid": "^11.13.0",
    "nspell": "^2.1.5",
    "zod": "4.4.3"
  }
}
