{
  "name": "com.asciidoc.joplin-plugin",
  "version": "1.0.1",
  "description": "adocLIVE AsciiDoc live-preview editor for Joplin",
  "license": "MIT",
  "author": "Amal Ghosh <amalghosh999@gmail.com>",
  "contributors": [
    "Amal Ghosh <amalghosh999@gmail.com>",
    "Codex <noreply@openai.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/amalghosh999/joplin-asciidoc-plugin.git"
  },
  "homepage": "https://github.com/amalghosh999/joplin-asciidoc-plugin",
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "scripts": {
    "build": "npm run build:jpl",
    "build:bundle": "webpack --mode=production",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('com.asciidoc.joplin-plugin.jpl',{force:true});\"",
    "build:jpl": "npm run clean && npm run build:bundle && cd dist && tar -czf ../com.asciidoc.joplin-plugin.jpl *",
    "deploy:joplin": "npm run build:jpl && node scripts/deploy-joplin.js",
    "typecheck": "tsc --noEmit --pretty false",
    "test:unit": "vitest run",
    "prepublishOnly": "npm run build:jpl && mkdir -p publish && cp com.asciidoc.joplin-plugin.jpl publish/",
    "release": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "dev": "webpack --mode=development --watch"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.11.0",
    "@types/nspell": "^2.1.6",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "happy-dom": "^20.9.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@mermaid-js/layout-elk": "^0.2.1",
    "asciidoctor": "^3.0.4",
    "asciimath2tex": "^1.5.0",
    "katex": "^0.16.39",
    "mermaid": "^11.13.0",
    "nspell": "^2.1.5"
  }
}
